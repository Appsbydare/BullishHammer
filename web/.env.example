# Copy to .env.local and fill in. Set the same keys in Vercel → Project → Settings → Environment Variables.

# Neon Postgres (project "BullishHammer"). Use the pooled connection string.
DATABASE_URL=

# Scanner data provider: twelvedata (Phase 1). mt5 arrives in Phase 3.
DATA_PROVIDER=twelvedata
TWELVE_DATA_API_KEY=

# Claude API, used for the daily AI news article (needs API credit on the Anthropic account)
ANTHROPIC_API_KEY=
# Optional: model and hard cost stop per article run (USD)
# NEWS_MODEL=claude-opus-5-5
# NEWS_MAX_COST_USD=2

# Admin login (/admin) and session signing
ADMIN_PASSWORD=
# Random 32+ byte string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/scan
CRON_SECRET=

# Public site URL (canonical links, sitemap). Production: https://bullishhammer.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: shown on /contact and /privacy (defaults to hello@bullishhammer.com)
NEXT_PUBLIC_CONTACT_EMAIL=

# Phase 2/3 (not used yet)
# RESEND_API_KEY=
# NEXT_PUBLIC_GA_ID=
