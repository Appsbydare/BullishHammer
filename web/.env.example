# Copy to .env.local and fill in real values.
# Every variable here (except NEXT_PUBLIC_SITE_URL) must also be set in
# Vercel → Project → Settings → Environment Variables before deploying.

# ── Sanity CMS ───────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=cx58gblo
NEXT_PUBLIC_SANITY_DATASET=production
# Editor-scoped token. Required for publishing and image uploads.
SANITY_API_WRITE_TOKEN=

# ── External data ────────────────────────────────────────────
# Live FX spot rates. 30-day sparkline history uses Frankfurter (no key needed).
CURRENCYFREAKS_API_KEY=
MARKETAUX_API_TOKEN=
POLLINATIONS_API_KEY=

# ── AI generation ────────────────────────────────────────────
# "openrouter" or "gemini"
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-8b-instruct:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
IMAGE_GEN_MODEL=flux

# ── Security ─────────────────────────────────────────────────
ADMIN_PASSWORD=
# Random 32+ byte string, e.g. `openssl rand -base64 32`
AUTH_SECRET=
AI_INGEST_SECRET=

# ── Optional ─────────────────────────────────────────────────
# Only used by the standalone generate-article.js script when targeting a
# remote deployment. The app resolves its own URL and does not need this.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
